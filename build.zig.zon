.{
    .name = .metrics,
    .version = "0.1.0",
    .fingerprint = 0x228aaae71697f1b8,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .thread_pool = .{
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git#ee8440f69012cad49fa1d5f22fe18c68f944d9ab",
            .hash = "thread_pool-0.2.0-11B1Bj_edQCU0Y_-zzOoXuytAgqEkDkfuw2nB-YxUmEL",
        },
        // otel observability seam. Lazy, so a default-flag build
        // (`-Dwith_otel=false`) never resolves or fetches the package.
        // Reached by `b.lazyDependency("otel", ...)` in build.zig only
        // when `-Dwith_otel=true`. Pin tracked in the otel rollout
        // plan; bump SHA + hash together via `zig fetch --save`.
        //
        // NOTE: otel itself depends on metrics under
        // `-Dotel_use_devnw_metrics=true`. The cycle is broken at build
        // time because both edges are lazy — otel's metrics edge is
        // only walked when the operator opts in, and metrics' otel edge
        // is only walked when -Dwith_otel=true. Neither default-flag
        // build resolves the other.
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel#20078af231c069d88eaeb79dcf950b94366be624",
            .hash = "otel-0.1.0-B0v3lsl9MwCHrG8GDrxdFebugqjybfr4KAiplOJKCRG7",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
    },
}
